VITE_API_BASE_URL=/api/v1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Docker/PostgreSQL
POSTGRES_DB=research_os
POSTGRES_USER=research_os
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql://research_os:replace-with-a-database-password@db:5432/research_os

# First-run bootstrap. Change this password before exposing the service.
SEED_DEMO=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=syins.yibinory@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-an-admin-password
GUNICORN_WORKERS=3
